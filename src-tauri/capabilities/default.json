{
  "identifier": "default",
  "description": "Default capabilities for Karizzma",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-fullscreen",
    "shell:allow-open",
    "store:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    "fs:read-all"
  ]
}
